@baseUrl = http://localhost:5236
@productId = 00000000-0000-0000-0000-000000000000
# Mint a local token (write scope included) and paste it here:
#   dotnet user-jwts create --project src/CleanArchitecture.Presentation --scope products:write
@token = paste-token-here

### Create a product
POST {{baseUrl}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "description": "Hot-swappable mechanical keyboard with brown switches.",
  "price": 89.99,
  "currency": "USD",
  "sku": "KB-100"
}

### Create a product — validation error (blank name)
POST {{baseUrl}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "",
  "description": "Invalid because the name is blank.",
  "price": 10,
  "currency": "USD",
  "sku": "KB-101"
}

### List products (first page)
GET {{baseUrl}}/api/products?pageNumber=1&pageSize=20
Authorization: Bearer {{token}}

### Get a product by id
GET {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{token}}

### Get a product by id — not found
GET {{baseUrl}}/api/products/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}

### Update a product
PUT {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Mechanical Keyboard (Tenkeyless)",
  "description": "Hot-swappable TKL mechanical keyboard with brown switches.",
  "price": 79.99,
  "currency": "USD"
}

### Delete (deactivate) a product
DELETE {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{token}}

### List products — no token (401 Unauthorized)
GET {{baseUrl}}/api/products
