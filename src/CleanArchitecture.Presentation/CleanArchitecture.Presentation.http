# 5236 = `dotnet run` / Aspire; use http://localhost:8080 for Docker Compose.
@baseUrl = http://localhost:5236
@productId = 00000000-0000-0000-0000-000000000000
# Filled in by the "Place an order" request below.
@orderId = {{placeOrder.response.body.$}}
# Keycloak: http:// under Docker Compose, https:// (dev certificate) under Aspire.
@keycloakUrl = http://localhost:8180/realms/clean-architecture

# Token source A (Docker Compose / Aspire): run the "Get a token from Keycloak" request below first.
# Swap in clean-architecture-reader / dev-only-reader-secret to get a read-only token (writes return 403).
@token = {{tokenRequest.response.body.access_token}}

# Token source B (API running alone): mint a token and paste it instead of the line above:
#   dotnet user-jwts create --project src/CleanArchitecture.Presentation --scope products:write --scope orders:write
# @token = paste-token-here

### Get a token from Keycloak (client credentials; DEV-ONLY secret from deploy/keycloak)
# @name tokenRequest
POST {{keycloakUrl}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=clean-architecture-service&client_secret=dev-only-service-secret

### Create a product
POST {{baseUrl}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "description": "Hot-swappable mechanical keyboard with brown switches.",
  "price": 89.99,
  "currency": "USD",
  "sku": "KB-100"
}

### Create a product — validation error (blank name)
POST {{baseUrl}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "",
  "description": "Invalid because the name is blank.",
  "price": 10,
  "currency": "USD",
  "sku": "KB-101"
}

### List products (first page)
GET {{baseUrl}}/api/products?pageNumber=1&pageSize=20
Authorization: Bearer {{token}}

### Get a product by id
GET {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{token}}

### Get a product by id — not found
GET {{baseUrl}}/api/products/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}

### Update a product
PUT {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Mechanical Keyboard (Tenkeyless)",
  "description": "Hot-swappable TKL mechanical keyboard with brown switches.",
  "price": 79.99,
  "currency": "USD"
}

### Delete (soft-delete) a product — afterwards GET returns 404
DELETE {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{token}}

### List products — no token (401 Unauthorized)
GET {{baseUrl}}/api/products

### Place an order for the caller (orders:write) — snapshots each product's name and price
# @name placeOrder
POST {{baseUrl}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "lines": [
    { "productId": "{{productId}}", "quantity": 2 }
  ]
}

### Place an order — validation error (no lines)
POST {{baseUrl}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "lines": []
}

### List my orders (newest first)
GET {{baseUrl}}/api/orders?pageNumber=1&pageSize=20
Authorization: Bearer {{token}}

### Get one of my orders by id — another customer's order returns 404
GET {{baseUrl}}/api/orders/{{orderId}}
Authorization: Bearer {{token}}

### Cancel one of my orders — a second cancel returns 409
POST {{baseUrl}}/api/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}
